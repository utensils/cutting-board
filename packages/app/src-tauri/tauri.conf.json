{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutting Board",
  "version": "0.1.0",
  "identifier": "com.utensils.cutting-board",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cutting Board",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "shortDescription": "Quick whiteboard for diagrams, sticky notes, and annotations.",
    "longDescription": "Cutting Board is a macOS menu-bar whiteboard for quickly sketching ideas, connecting shapes with diagram arrows, and dropping colored sticky notes. Open it with a global hotkey, annotate a pasted screenshot, then copy the result to your clipboard and paste it anywhere.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  }
}
