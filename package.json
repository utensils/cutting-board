{
  "name": "cutting-board",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS menu-bar whiteboard for quick diagrams, sticky notes, and annotations — copy to clipboard and paste anywhere.",
  "license": "MIT",
  "author": "Utensils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utensils/cutting-board.git"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @cutting-board/app dev",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "lint": "pnpm -r --filter \"./packages/**\" lint",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "tauri": "pnpm --filter @cutting-board/app tauri",
    "tauri:dev": "pnpm --filter @cutting-board/app tauri dev",
    "tauri:build": "pnpm --filter @cutting-board/app tauri build",
    "icon": "pnpm --filter @cutting-board/app tauri icon ../../assets/logo.png",
    "mcp": "pnpm --filter @cutting-board/mcp-server start"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
